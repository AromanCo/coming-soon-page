# Copy to .env.bots (ignored by git). Never commit actual bot tokens.
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# Public HTTPS origin. Telegram and Bale users can open result links.
BOT_PUBLIC_SITE_URL=https://aroman.ir

# Leave empty for text-only delivery during local development.
# Once deployed and externally accessible over HTTPS, set to https://aroman.ir.
BOT_MEDIA_BASE_URL=

# Optional immutable image tag for controlled releases.
SCENT_BOT_IMAGE_TAG=local
