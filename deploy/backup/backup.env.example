# Install as /etc/aroman/backup.env with owner root and mode 0600.
AROMAN_APP_DIR=/opt/aroman/app
AROMAN_ENV_FILE=/etc/aroman/production.env
AROMAN_BACKUP_DIR=/var/backups/aroman
AROMAN_BACKUP_PASSPHRASE_FILE=/etc/aroman/backup-passphrase
AROMAN_BACKUP_RETENTION_DAYS=30

# Optional rclone destination. Configure the remote separately and restrict its
# credentials. Example: encrypted-remote:aroman/postgres
AROMAN_BACKUP_REMOTE=
