# Canonical public URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://example.com

# PostgreSQL connection used only by the server-side waitlist API
DATABASE_URL=postgresql://user:password@host:5432/aroman
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Generate at least 32 random bytes, for example: openssl rand -hex 32
WAITLIST_HASH_SECRET=replace-with-a-long-random-secret

# Optional; links are hidden when they are not configured
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_PRIVACY_EMAIL=
