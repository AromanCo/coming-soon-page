# Docker Compose project and published application port
COMPOSE_PROJECT_NAME=aroman-coming-soon
WEB_PORT=3000

# Canonical public URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL 16 container credentials
POSTGRES_USER=aroman
POSTGRES_PASSWORD=replace-with-a-strong-url-encoded-password
POSTGRES_DB=aroman

# Server-only connection string. The Docker hostname must remain "db".
# Keep this password synchronized with POSTGRES_PASSWORD.
DATABASE_URL=postgresql://aroman:replace-with-a-strong-url-encoded-password@db:5432/aroman
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Generate at least 32 random bytes, for example: openssl rand -hex 32
WAITLIST_HASH_SECRET=replace-with-a-long-random-secret

# Optional; links are hidden when they are not configured
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_PRIVACY_EMAIL=
