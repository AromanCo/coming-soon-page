# Non-secret production configuration. Copy to a root-owned file on the VPS,
# for example /etc/aroman/production.env with mode 0600.
COMPOSE_PROJECT_NAME=aroman-production
AROMAN_IMAGE_TAG=replace-with-release-git-sha
AROMAN_DOMAIN=example.com
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

POSTGRES_DB=aroman
POSTGRES_ADMIN_USER=aroman_admin
POSTGRES_MIGRATION_USER=aroman_migrate
POSTGRES_APP_USER=aroman_app

# Directory containing the four files listed in deploy/secrets/README.md.
AROMAN_SECRETS_DIR=/etc/aroman/secrets
